# ============================================================
# es21plus – Variables de Entorno
# @author Carlos Vico
#
# Copia este archivo como .env y rellena los valores reales.
# NUNCA hagas commit del archivo .env
# ============================================================

# --- Base de Datos ---
DB_HOST=db
DB_PORT=3306
DB_NAME=inventario_motos
DB_USER=admin
DB_PASS=secret

# --- MySQL root (solo para Docker) ---
MYSQL_ROOT_PASSWORD=secret

# --- Aplicación ---
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# --- Stock mínimo por defecto ---
STOCK_MINIMO_ALERTA=5

# --- Email / Alertas de stock ---
ALERT_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=secret
SMTP_FROM_NAME=es21plus Inventario

# --- Email / Panel Superadmin (alias de SMTP_* — puede ser el mismo) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=es21plus

# --- Superadmin ---
SUPERADMIN_EMAIL=superadmin@example.com

# --- Seguridad (cifrado contraseña SMTP) ---
# Genera una clave aleatoria: openssl rand -base64 32
APP_KEY=
