# Ignorar archivos de entorno (nunca commitear credenciales reales)
.env
.env.example
.env.testing

# Ignorar prompts internos y documentación de Claude Code (uso local)
PROMPTS_CLAUDE_CODE.md
CLAUDE.md

# Ignorar dependencias de Composer (si las usas)
vendor/

# Ignorar hooks locales de Git
.githooks/

# Ignorar archivos de sistema
.DS_Store
Thumbs.db

# Ignorar logs
*.log

# Ignorar posibles datos locales de Docker (si usas montajes locales)
/database/data/

.CLAUDE.md
.githooks/
.claude/
.PROMPTS_CLAUDE_CODE.md

# Imágenes subidas por usuarios (contenido, no código)
/src/uploads/productos/*
!/src/uploads/productos/.gitkeep

# Informes de cobertura de tests (generados por phpunit)
coverage.xml
coverage-unit.xml