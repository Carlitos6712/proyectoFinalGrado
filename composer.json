{
    "name": "es21plus/sistema-inventario-motos",
    "description": "Sistema de inventario para taller mecánico de motos",
    "type": "project",
    "require": {
        "php": "^8.1",
        "setasign/fpdf": ">=1.7",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "classmap": [
            "src/includes/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "test":             "phpunit",
        "test:unit":        "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:coverage":    "phpunit --coverage-text --coverage-clover=coverage.xml"
    },
    "config": {
        "optimize-autoloader": true
    }
}
